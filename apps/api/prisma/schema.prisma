generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users and auth ──────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  isAdmin         Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  business         Business?
  staffMemberships StaffMember[]
  bookings         Booking[]
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Businesses ──────────────────────────────────────────────────

enum BusinessCategory {
  CLINIC
  BARBER
  TUTOR
  GYM
  OTHER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @unique @db.Uuid
  name              String
  slug              String           @unique
  description       String?
  category          BusinessCategory
  address           String
  timezone          String
  logoUrl           String?
  coverUrl          String?
  minNoticeMinutes  Int              @default(120)
  maxDaysAhead      Int              @default(60)
  cancelCutoffHours Int              @default(24)
  status            BusinessStatus   @default(ACTIVE)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  owner    User          @relation(fields: [ownerId], references: [id])
  services Service[]
  staff    StaffMember[]
  invites  StaffInvite[]
  bookings Booking[]

  // Discovery lists ACTIVE businesses, optionally filtered by category.
  @@index([status, category])
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  /// Prep/cleanup time after the service; blocks the staff member but isn't shown to the customer.
  bufferMinutes   Int      @default(0)
  /// Integer cents to avoid floating-point rounding (2500 = 25.00).
  priceCents      Int
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    StaffService[]
  bookings Booking[]

  @@index([businessId])
}

// ─── Staff and availability ──────────────────────────────────────

model StaffMember {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  services     StaffService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  bookings     Booking[]

  @@unique([businessId, userId])
  @@index([userId])
}

/// Which staff members perform which services (many-to-many).
model StaffService {
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model StaffInvite {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// Weekly hours in the business's LOCAL time, so they stay correct across DST changes.
model WorkingHours {
  id          String @id @default(uuid()) @db.Uuid
  staffId     String @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek   Int
  /// Minutes since local midnight (09:00 = 540)
  startMinute Int
  endMinute   Int

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

/// Exact moments, stored in UTC.
model TimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @db.Uuid
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
}

// ─── Bookings and payments ───────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  EXPIRED
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  customerId      String        @db.Uuid
  businessId      String        @db.Uuid
  serviceId       String        @db.Uuid
  staffId         String        @db.Uuid
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  /// endsAt + buffer. The double-booking constraint checks [startsAt, blockedUntil).
  blockedUntil    DateTime      @db.Timestamptz(3)
  /// Copied from the service when booked, so later service edits don't change this booking.
  durationMinutes Int
  bufferMinutes   Int
  priceCents      Int
  currency        String
  status          BookingStatus @default(PENDING)
  /// When an unpaid PENDING booking stops holding its slot.
  expiresAt       DateTime?     @db.Timestamptz(3)
  cancelledAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  customer User        @relation(fields: [customerId], references: [id])
  business Business    @relation(fields: [businessId], references: [id])
  service  Service     @relation(fields: [serviceId], references: [id])
  staff    StaffMember @relation(fields: [staffId], references: [id])
  payment  Payment?

  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
  @@index([businessId, startsAt])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  bookingId               String        @unique @db.Uuid
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?       @unique
  amountCents             Int
  currency                String
  status                  PaymentStatus @default(PENDING)
  refundedAt              DateTime?     @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])
}

/// Stripe event IDs already handled, so a redelivered webhook has no extra effect.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}
