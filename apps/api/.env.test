# Used by Vitest. Safe to commit: points at a throwaway test database, no real secrets.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgresql://booking:booking@localhost:5440/booking_test
# Redis database 1, so test jobs never mix with development jobs in database 0.
REDIS_URL=redis://localhost:6379/1
JWT_ACCESS_SECRET=test-only-secret-that-is-at-least-32-characters-long
# Minimum bcrypt cost: test users don't need strong hashes, and 12 rounds makes tests slow.
BCRYPT_ROUNDS=4
# Fake Stripe values in the right format. Tests replace the Stripe client and never call Stripe.
STRIPE_SECRET_KEY=sk_test_fake_key_for_tests
STRIPE_WEBHOOK_SECRET=whsec_fake_secret_for_tests
WEB_URL=http://localhost:3000
# Fake Cloudinary account: tests only check signatures, nothing is uploaded.
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test-cloudinary-secret
# Tests send many requests from one address; the limiter has its own tests.
RATE_LIMIT_ENABLED=false
