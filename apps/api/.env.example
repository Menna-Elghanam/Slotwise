# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgresql://booking:booking@localhost:5440/booking
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Optional. Password hashing cost (default 12). Only lower it for tests.
# BCRYPT_ROUNDS=12

# Stripe test mode: https://dashboard.stripe.com/test/apikeys (secret key, starts with sk_test_).
STRIPE_SECRET_KEY=
# Locally, `stripe listen --forward-to localhost:4000/webhooks/stripe` prints this (whsec_...).
STRIPE_WEBHOOK_SECRET=
# The web app's address; Stripe sends customers back here after paying.
WEB_URL=http://localhost:3000
# The web app proxies /api/* to this API, so the browser sees it under /api.
API_PATH_PREFIX=/api

# Optional. Defaults to Mailpit from docker-compose (open http://localhost:8025 to read emails).
# In production use your provider's SMTP URL, e.g. smtps://resend:API_KEY@smtp.resend.com:465
# SMTP_URL=smtp://localhost:1025
# EMAIL_FROM=Booking Platform <no-reply@booking.local>

# Optional. Image uploads (business logo and cover). From https://console.cloudinary.com
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional. Set to 1 when deployed behind one proxy (Railway, Render), so rate limits see
# each visitor's real IP address.
# TRUST_PROXY_HOPS=0
# RATE_LIMIT_ENABLED=true

# Optional. Error reporting: the DSN from your Sentry project's settings.
# SENTRY_DSN=
